TELEGRAM_BOT_TOKEN=your_telegram_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Primary and summary models. Use `auto` for auto-selection.
GEMINI_MODEL=auto
GEMINI_SUMMARY_MODEL=auto

# Optional fallback models (comma-separated).
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest,gemini-flash-lite-latest

# Group trigger text. If this is not your real bot username mention,
# disable privacy mode in BotFather (/setprivacy -> Disable).
TRIGGER_MENTION=@ai

SYSTEM_PROMPT=You are a practical and helpful assistant. Answer clearly and stay on task.
SQLITE_PATH=bot_memory.sqlite3
MAX_CONTEXT_TOKENS=2800
MAX_REPLY_TOKENS=900
RECENT_MESSAGES=20
GROUP_RECENT_MESSAGES=20
GROUP_FOCUS_MESSAGES=18
RETRIEVAL_MAX_MESSAGES=10
RETRIEVAL_LOOKBACK_MESSAGES=320
RETRIEVAL_MAX_TOKENS=520
SUMMARY_TRIGGER_MESSAGES=55
SUMMARY_INPUT_TOKENS=2400
SUMMARY_OUTPUT_TOKENS=280
SUMMARY_MAX_CHARS=2200
TEMPERATURE=0.4
# Optional multiple Gemini keys, separated by spaces or commas.
# Keys in the same Google project share the same quota; rotation is for credential failures/failover.
GEMINI_API_KEYS=
PRIVATE_DAILY_TOKEN_LIMIT=40000
GROUP_DAILY_TOKEN_LIMIT=150000
MEMORY_RETENTION_DAYS=30
MAX_VOICE_SECONDS=120
# Optional private-chat top-up packages, format TOKENS:STARS separated by commas.
# Choose pricing before enabling, e.g. STAR_TOKEN_PACKS=100000:50,500000:200
STAR_TOKEN_PACKS=

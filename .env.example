# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_token_here

# Select gemini or openai-compatible. Use your own provider account and key.
AI_PROVIDER=gemini

# Gemini API credentials. Either use GEMINI_API_KEY or a space/comma-separated key list.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=auto
# Auto mode uses economical Flash-Lite models. Optional manual fallbacks may cost money.
GEMINI_FALLBACK_MODELS=

# For OpenAI-compatible APIs (OpenAI, OpenRouter, Groq, Together, compatible gateways):
# AI_PROVIDER=openai-compatible
# AI_API_KEY=your_provider_key
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_MODEL=your-model-id
# TRANSCRIPTION_MODEL=whisper-1
# Leave TRANSCRIPTION_MODEL blank if the provider has no /audio/transcriptions endpoint.

# Group trigger text. BotFather privacy mode must be disabled to read ambient group text.
TRIGGER_MENTION=@ai
SYSTEM_PROMPT=You are a practical and helpful assistant. Answer clearly and stay on task.
SQLITE_PATH=data/bot_memory.sqlite3

# Token and context limits
MAX_CONTEXT_TOKENS=2800
MAX_REPLY_TOKENS=900
RECENT_MESSAGES=20
GROUP_RECENT_MESSAGES=20
GROUP_FOCUS_MESSAGES=0
RETRIEVAL_MAX_MESSAGES=10
RETRIEVAL_LOOKBACK_MESSAGES=320
RETRIEVAL_MAX_TOKENS=520
TEMPERATURE=0.4
PRIVATE_DAILY_TOKEN_LIMIT=40000
GROUP_DAILY_TOKEN_LIMIT=150000
GLOBAL_DAILY_TOKEN_LIMIT=500000

# Memory, voice, and database management
MEMORY_RETENTION_DAYS=30
MAX_VOICE_SECONDS=120
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash-lite
MAX_DATABASE_MB=500

# Optional private-chat Stars top-ups. Price is Stars: TOKENS:STARS, comma-separated.
# Example: STAR_TOKEN_PACKS=100000:50,500000:200
STAR_TOKEN_PACKS=
